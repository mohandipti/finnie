# Copy to .env and fill in your keys. Never commit .env.

# Required: Gemini chat model and Google embeddings (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# live market data (https://www.alphavantage.co/support/#api-key).  
ALPHA_VANTAGE_API_KEY=

# Live news feed from SerpAPI (https://serpapi.com/manage-api-key).  
SERP_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# LLM_THINKING_BUDGET=0              # 0 (default) = no hidden reasoning, fastest; unset to use the model's own
# Per-agent LLM settings (JSON). Components: router, synthesizer, finance_qa, portfolio,
# market, goal_planning, news, tax. Unset fields use the defaults above.
# AGENT_LLM={"router": {"thinking_budget": 0}, "finance_qa": {"temperature": 0.3}}
# EMBEDDING_PROVIDER=google          # or "local" (sentence-transformers, offline, no key)
# FAISS_INDEX_DIR=data/index
# LOG_LEVEL=INFO
